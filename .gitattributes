# Store all text files as LF in the repository AND check them out as LF,
# on Windows too. This overrides core.autocrlf, so both platforms see
# identical bytes and diffs never show phantom whole-file changes.
* text=auto eol=lf

# Binary assets — never munge these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.ogg binary
*.wav binary
*.glb binary
*.gltf binary
*.hdr binary
